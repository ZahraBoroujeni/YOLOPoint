<?xml version="1.0"?>
<package format="3">
  <name>object_msgs</name>
  <version>0.0.1</version>
  <description>The object_msgs package (ROS2 version)</description>

  <maintainer email="andreas.reich@unibw.de">anre</maintainer>
  <maintainer email="thorsten.luettel@unibw.de">thlu</maintainer>

  <license>TODO</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Message generation -->
  <build_depend>rosidl_default_generators</build_depend>

  <!-- Runtime dependencies -->
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Eigen3 dependency -->
  <build_depend>eigen3_cmake_module</build_depend>
  <build_export_depend>eigen3_cmake_module</build_export_depend>
  <exec_depend>eigen3_cmake_module</exec_depend>

  <!-- Must declare message package group -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>