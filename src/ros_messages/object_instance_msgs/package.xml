<?xml version="1.0"?>
<package format="3">
  <name>object_instance_msgs</name>
  <version>0.0.1</version>
  <description>Custom messages used for a lidar object instance</description>

  <maintainer email="andreas.reich@unibw.de">Andreas Reich</maintainer>

  <license>TODO</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies required to build messages -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <!-- ROS message dependencies -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Export section -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>